; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SLiDE"
config/description="Sunlite IDE."
config/version="2.0.0"
run/main_scene="uid://bkmiht7cjvpdc"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=60
config/icon="uid://bddln6gx8xxuu"

[autoload]

NELogger="*uid://cndxd3d3bpn01"

[display]

window/subwindows/embed_subwindows=false
window/per_pixel_transparency/allowed=true

[editor]

naming/default_signal_callback_name="on{NodeName}{SignalName}"
naming/default_signal_callback_to_self_name="on{SignalName}"
naming/script_name_casing=1

[input]

save={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":true,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":83,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
